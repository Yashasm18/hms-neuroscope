  "model": {
    "type": "RandomForestClassifier",
    "class_weight": "balanced",
    "random_state": 42,
    "n_estimators": 100
  },
  "optimal_threshold": 0.5,
  "software_versions": {
    "python": "3.11.15",
    "mne": "1.13.2",
    "scikit_learn": "1.7.2",
    "numpy": "2.4.6",
    "scipy": "1.17.1"
  }
}